<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.horizon</groupId>
    <artifactId>leadseal-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>leadseal-it</artifactId>
  <name>Leadseal - Integration tests</name>
  <description>Runs protoc-gen-leadseal through protoc on a schema that changes in steps, and applies the migrations with Flyway.</description>

  <properties>
    <module.name>dev.horizon.leadseal.it</module.name>
    <leadseal.migrations>${project.build.directory}/migrations</leadseal.migrations>
    <protobuf.compiler.incremental>false</protobuf.compiler.incremental>
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>dev.horizon</groupId>
      <artifactId>leadseal-protoc</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>dev.horizon</groupId>
      <artifactId>leadseal-protobuf</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-sqlserver</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-mariadb</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-mssqlserver</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mariadb.jdbc</groupId>
      <artifactId>mariadb-java-client</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.microsoft.sqlserver</groupId>
      <artifactId>mssql-jdbc</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <executions>
          <execution>
            <id>clean-migrations</id>
            <phase>initialize</phase>
            <goals>
              <goal>clean</goal>
            </goals>
            <configuration>
              <excludeDefaultDirectories>true</excludeDefaultDirectories>
              <filesets>
                <fileset>
                  <directory>${leadseal.migrations}</directory>
                </fileset>
              </filesets>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>io.github.ascopes</groupId>
        <artifactId>protobuf-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>step1</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>generate-test</goal>
            </goals>
            <configuration>
              <javaEnabled>false</javaEnabled>
              <sourceDirectories>
                <sourceDirectory>${project.basedir}/src/test/protobuf/step1</sourceDirectory>
              </sourceDirectories>
              <outputDirectory>${project.build.directory}/generated-test-sources/step1</outputDirectory>
              <registerAsCompilationRoot>false</registerAsCompilationRoot>
              <plugins>
                <plugin kind="jvm-maven">
                  <groupId>dev.horizon</groupId>
                  <artifactId>leadseal-protoc</artifactId>
                  <version>${project.version}</version>
                  <options>migrations=${leadseal.migrations},dialect=postgresql,dialect=mariadb,dialect=sqlserver,dialect=sqlite</options>
                  <outputDirectory>${leadseal.migrations}</outputDirectory>
                  <registerAsCompilationRoot>false</registerAsCompilationRoot>
                </plugin>
              </plugins>
            </configuration>
          </execution>
          <execution>
            <id>step2</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>generate-test</goal>
            </goals>
            <configuration>
              <javaEnabled>false</javaEnabled>
              <sourceDirectories>
                <sourceDirectory>${project.basedir}/src/test/protobuf/step2</sourceDirectory>
              </sourceDirectories>
              <outputDirectory>${project.build.directory}/generated-test-sources/step2</outputDirectory>
              <registerAsCompilationRoot>false</registerAsCompilationRoot>
              <plugins>
                <plugin kind="jvm-maven">
                  <groupId>dev.horizon</groupId>
                  <artifactId>leadseal-protoc</artifactId>
                  <version>${project.version}</version>
                  <options>migrations=${leadseal.migrations},dialect=postgresql,dialect=mariadb,dialect=sqlserver,dialect=sqlite</options>
                  <outputDirectory>${leadseal.migrations}</outputDirectory>
                  <registerAsCompilationRoot>false</registerAsCompilationRoot>
                </plugin>
              </plugins>
            </configuration>
          </execution>
          <execution>
            <id>step3</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>generate-test</goal>
            </goals>
            <configuration>
              <javaEnabled>false</javaEnabled>
              <sourceDirectories>
                <sourceDirectory>${project.basedir}/src/test/protobuf/step3</sourceDirectory>
              </sourceDirectories>
              <outputDirectory>${project.build.directory}/generated-test-sources/step3</outputDirectory>
              <registerAsCompilationRoot>false</registerAsCompilationRoot>
              <plugins>
                <plugin kind="jvm-maven">
                  <groupId>dev.horizon</groupId>
                  <artifactId>leadseal-protoc</artifactId>
                  <version>${project.version}</version>
                  <options>migrations=${leadseal.migrations},dialect=postgresql,dialect=mariadb,dialect=sqlserver,dialect=sqlite</options>
                  <outputDirectory>${leadseal.migrations}</outputDirectory>
                  <registerAsCompilationRoot>false</registerAsCompilationRoot>
                </plugin>
              </plugins>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <skipIfEmpty>true</skipIfEmpty>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <leadseal.migrations>${leadseal.migrations}</leadseal.migrations>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
