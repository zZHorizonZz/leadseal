<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.horizon</groupId>
    <artifactId>leadseal-parent</artifactId>
    <version>0.1.1-SNAPSHOT</version>
  </parent>

  <artifactId>leadseal-it</artifactId>
  <name>Leadseal - Integration tests</name>
  <description>Runs protoc-gen-leadseal through protobuf-maven-plugin on a schema that changes in steps, and applies the migrations with Flyway.</description>

  <properties>
    <module.name>dev.horizon.leadseal.it</module.name>
    <leadseal.migrations>${project.build.directory}/migrations</leadseal.migrations>
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>dev.horizon</groupId>
      <artifactId>leadseal-protoc</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>dev.horizon</groupId>
      <artifactId>leadseal-protobuf</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-sqlserver</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-mariadb</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-mssqlserver</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mariadb.jdbc</groupId>
      <artifactId>mariadb-java-client</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.microsoft.sqlserver</groupId>
      <artifactId>mssql-jdbc</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>io.github.ascopes</groupId>
        <artifactId>protobuf-maven-plugin</artifactId>
        <configuration>
          <javaEnabled>false</javaEnabled>
          <incrementalCompilation>false</incrementalCompilation>
          <plugins>
            <plugin kind="jvm-maven">
              <groupId>dev.horizon</groupId>
              <artifactId>leadseal-protoc</artifactId>
              <version>${project.version}</version>
              <options>migrations=${leadseal.migrations},dialect=postgresql,dialect=mariadb,dialect=sqlserver,dialect=sqlite</options>
              <outputDirectory>${leadseal.migrations}</outputDirectory>
              <registerAsCompilationRoot>false</registerAsCompilationRoot>
            </plugin>
          </plugins>
        </configuration>
        <executions>
          <execution>
            <id>step1</id>
            <goals>
              <goal>generate-test</goal>
            </goals>
            <configuration>
              <sourceDirectories>
                <sourceDirectory>${project.basedir}/src/test/protobuf/step1</sourceDirectory>
              </sourceDirectories>
            </configuration>
          </execution>
          <execution>
            <id>step2</id>
            <goals>
              <goal>generate-test</goal>
            </goals>
            <configuration>
              <sourceDirectories>
                <sourceDirectory>${project.basedir}/src/test/protobuf/step2</sourceDirectory>
              </sourceDirectories>
            </configuration>
          </execution>
          <execution>
            <id>step3</id>
            <goals>
              <goal>generate-test</goal>
            </goals>
            <configuration>
              <sourceDirectories>
                <sourceDirectory>${project.basedir}/src/test/protobuf/step3</sourceDirectory>
              </sourceDirectories>
            </configuration>
          </execution>
          <execution>
            <id>step3-unchanged</id>
            <goals>
              <goal>generate-test</goal>
            </goals>
            <configuration>
              <sourceDirectories>
                <sourceDirectory>${project.basedir}/src/test/protobuf/step3</sourceDirectory>
              </sourceDirectories>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <skipIfEmpty>true</skipIfEmpty>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <leadseal.migrations>${leadseal.migrations}</leadseal.migrations>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
